# Copy to .env and replace every placeholder. Compose never applies migrations.
# For an existing postgres_data volume, use its current ledger_app password here;
# POSTGRES_PASSWORD only initializes an empty PostgreSQL data directory.
POSTGRES_PASSWORD=replace-with-existing-local-postgres-password

# The target database must already have V1-V7 applied and ledger_runtime provisioned.
LEDGER_DB_USER=ledger_runtime
LEDGER_DB_PASSWORD=replace-with-ledger-runtime-password
LEDGER_FLYWAY_USER=ledger_migrator
LEDGER_FLYWAY_PASSWORD=

# Single local operator. Use unique random values; these are server-side only.
LEDGER_OPERATOR_USERNAME=ledger-operator
LEDGER_OPERATOR_PASSWORD=replace-with-random-password-at-least-24-characters
LEDGER_SESSION_SECRET=replace-with-random-session-secret-at-least-32-characters
LEDGER_APP_ORIGIN=http://127.0.0.1:3000

LEDGER_UI_PORT=3000
# Razorpay Test Mode; backend only. Leave blank until configured.
LEDGER_RAZORPAY_KEY_ID=
LEDGER_RAZORPAY_API_SECRET=
LEDGER_RAZORPAY_WEBHOOK_SECRET=
